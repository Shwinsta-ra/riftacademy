{
  "permissions": {
    "deny": [
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "mcp__github__merge_pull_request"
    ],
    "defaultMode": "acceptEdits"
  }
}
